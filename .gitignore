# content & uploads (mounted as Docker volumes)
#
# 편집 내용(items/settings)은 추적하고 런타임 상태는 뺀다. 허용 목록인 이유는
# auth.json(비밀번호 해시) 때문 — 차단 목록이면 새 파일이 기본으로 딸려 올라간다.
#   views.json  방문자가 열 때마다 서버가 고쳐 쓴다
#   github-stats.json  크론이 하루 한 번 GitHub에서 받아 쓴다
#   auth.json   관리자 비밀번호 scrypt 해시. 절대 올리지 않는다
/content/*
!/content/items.json
!/content/settings.json

# 배포가 서버 쪽 content/ 수정을 되돌리기 전에 남기는 백업
/deploy-backups/
/public/uploads/

# claude code local settings (machine-specific permissions)
.claude/settings.local.json

# claude code project files
.claude/
_workspace/
.superpowers/
CLAUDE.md

# 내부 프로세스 문서(설계/계획) — 공개 레포에서 제외, 로컬 전용
/docs/superpowers/
/.worktrees/
