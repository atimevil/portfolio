generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Post {
  id         Int       @id @default(autoincrement())
  slug       String    @unique
  title      String
  content    String
  excerpt    String
  date       DateTime
  status     String
  contentFormat String  @default("markdown") // "markdown"(기존) | "html"(무손실 에디터)
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  categoryId Int?
  tags       PostTag[]
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model Tag {
  id    Int       @id @default(autoincrement())
  name  String    @unique
  posts PostTag[]
}

model PostTag {
  postId Int
  tagId  Int
  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag    Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
}

model Category {
  id    Int    @id @default(autoincrement())
  name  String @unique
  posts Post[]
}

// 맛집지도 — 가보고 싶은 곳을 미리 모아두는 개인 위시리스트(비공개, 관리자 전용).
// 카테고리는 값 종류가 적어 별도 테이블 없이 문자열로 둔다.
model Restaurant {
  id        Int      @id @default(autoincrement())
  name      String
  lat       Float
  lng       Float
  address   String?
  category  String?
  menus     String? // 추천 메뉴, 자유 텍스트 (예: "우니동, 사케동")
  memo      String?
  placeId   String?  @unique // 구글 place_id — 같은 가게 중복 등록 방지
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
